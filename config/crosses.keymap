#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

&lt {
    tapping-term-ms = <200>;
    flavor = "balanced";
    quick-tap-ms = <150>;
};
    
/ {
    keymap {
        compatible = "zmk,keymap";

        Base {
            bindings = <
&kp TILDE    &kp N1  &kp N2  &kp N3                    &kp N4         &kp N5     &kp N6     &kp N7   &kp N8                    &kp N9         &kp N0      &kp LEFT_BRACKET
&kp TAB      &kp B   &kp L   &kp D                     &kp C          &kp V      &kp J      &kp F    &kp O                     &kp U          &kp COMMA   &kp RIGHT_BRACKET
&kp MINUS    &kp N   &kp R   &kp T                     &kp S          &kp G      &kp Y      &kp H    &kp A                     &kp E          &kp I       &kp SLASH
&lt 2 EQUAL  &kp X   &kp Q   &kp M                     &kp W          &kp Z      &kp K      &kp P    &kp SQT                   &kp SEMICOLON  &kp PERIOD  &lt 2 BACKSLASH
                             &mt RIGHT_CONTROL ESCAPE  &kp BACKSPACE  &kp ENTER  &kp SPACE  &kp DEL  &mt RIGHT_SHIFT CAPSLOCK
            >;
        };

        Lower {
            bindings = <
&kp LC(LS(ESCAPE))  &kp LG(I)           &kp LG(PERIOD)      &kp LG(E)       &kp LG(LS(S))        &kp LG(PRINTSCREEN)  &kp CARET  &kp NUMBER_7  &kp N8        &kp N9        &kp MINUS     &kp LEFT_PARENTHESIS
&kp HOME            &kp LC(UP_ARROW)    &kp LC(LEFT_ARROW)  &kp UP_ARROW    &kp LC(RIGHT_ARROW)  &kp PAGE_UP          &none      &kp NUMBER_4  &kp N5        &kp NUMBER_6  &kp PLUS      &kp RIGHT_PARENTHESIS
&kp END             &kp LC(DOWN_ARROW)  &kp LEFT_ARROW      &kp DOWN_ARROW  &kp RIGHT_ARROW      &kp PAGE_DOWN        &kp EQUAL  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp SLASH     &kp SQT
&kp LC(Y)           &kp LC(Z)           &kp LC(X)           &kp LC(C)       &kp LC(V)            &kp LC(A)            &kp COMMA  &kp N0        &kp N0        &kp PERIOD    &kp ASTERISK  &kp DOUBLE_QUOTES
                                                            &trans          &trans               &trans               &trans     &trans        &trans
            >;
        };

        Raise {
            bindings = <
&kp F1      &kp F2      &kp F3         &kp F4         &kp F5          &kp F6        &kp F7         &kp F8    &kp F9     &kp F10  &kp F11 &kp F12           
&kp TAB           &kp Q      &kp W    &kp E    &kp R    &kp T        &kp Y    &kp U    &kp I        &kp O    &kp P        &kp BSLH
&kp LEFT_SHIFT    &kp A      &kp S    &kp D    &kp F    &kp G        &kp H    &kp J    &kp UP_ARROW        &kp L    &kp SEMI    &kp APOS
&kp LCTRL         &kp Z    &kp X    &kp C    &kp V    &kp B          &kp N    &kp LEFT_ARROW    &kp DOWN_ARROW    &kp RIGHT_ARROW  &kp SLASH  &kp ESC
                       &none           &none            &none            &none      &none    &none
            >;
        };

        Mouse {
            bindings = <
&none    &none          &none           &none           &none       &none               &none       &none   &none         &none         &none           &none
&none    &bt BT_SEL 0   &bt BT_SEL 1    &bt BT_SEL 3    &none       &bt BT_CLR          &bt BT_CLR  &none   &bt BT_SEL 2  &bt BT_SEL 1  &bt BT_SEL 0    &none
&none    &none          &none           &none           &none       &none               &none       &none   &none         &none         &none           &none
&none    &none          &none           &none          &none        &none               &studio_unlock       &none   &none         &none         &none           &none
              &mkp MCLK  &mkp LCLK  &mkp RCLK    &mkp RCLK   &mkp LCLK    &mkp MCLK
            >;
        };

    };
 
};
